{
  "expo": {
    "name": "Archer",
    "slug": "archer",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "archer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fbfaf8",
    "ios": {
      "bundleIdentifier": "dev.tryarcher.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.tryarcher.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0f1117"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "archer"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#fbfaf8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f1012"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
