# Convex (written automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Context.dev — only needed to run scripts/fetch-styleguide.ts. Server-side
# secret, never expose to the client.
# Keys: https://www.context.dev/dashboard/api-keys
CONTEXT_DEV_API_KEY=

# Clerk — sign-in (GitHub login). Clerk dashboard → API keys.
# Also in the dashboard: enable GitHub under SSO connections, and create a
# JWT template named "convex"; set its issuer (the Frontend API URL) on the
# Convex deployment: `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://…`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes — the app has its own sign-in / sign-up pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Hosted MCP route (/mcp) acts for OAuth-verified users with this secret.
# Generate once (e.g. openssl rand -base64 48) and set the SAME value on the
# Convex deployment: npx convex env set ARCHER_SERVICE_SECRET <value>
ARCHER_SERVICE_SECRET=

# Repo sync (docs/repo-sync.md). Pushes reach /api/github/webhook signed with
# this secret (a repository webhook or the Archer GitHub App). Optional: without
# it, documents stored in a repository sync when they're opened.
GITHUB_WEBHOOK_SECRET=
# Optional: the Archer GitHub App (syncs read as its installation; teammates
# without write access can still publish pull requests). PEM, \n escapes ok.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional: GitHub Enterprise REST base URL (default https://api.github.com).
GITHUB_API_URL=
